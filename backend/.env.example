# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=copilot-files

# Azure Entra ID (set auth_enabled=true to enforce)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AUTH_ENABLED=false

# Workspace directory (where agents/skills are installed)
WORKSPACE_DIR=/workspace
AGENTS_DIR=.github/agents
SKILLS_DIR=.github/skills

# Copilot defaults (1M context alias and explicit reasoning effort)
COPILOT_MODEL=claude-opus-5.5-1m
COPILOT_REASONING_EFFORT=high

# CORS (comma-separated origins — restrict in production!)
CORS_ORIGINS=["http://localhost:8000"]

# Azure Communication Services (for cron job email notifications)
AZURE_COMM_CONNECTION_STRING=
EMAIL_SENDER_ADDRESS=
